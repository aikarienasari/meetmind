# ─────────────────────────────────────────────────────────────
# MeetMind Frontend Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy file ini ke `.env` (dev) atau set di Vercel Project Settings
# (Production). Jangan commit file `.env` yang berisi nilai asli.
#
# Vite hanya baca env yang diawali VITE_.


# ─── Backend API ─────────────────────────────────────────────
# URL dasar backend FastAPI (tanpa trailing slash).
# Dev:   http://localhost:8000
# Prod:  https://meeting-ai-backend-production-b61e.up.railway.app
VITE_BACKEND_URL=http://localhost:8000

# WebSocket URL (tanpa trailing slash).
# Dev:   ws://localhost:8000
# Prod:  wss://meeting-ai-backend-production-b61e.up.railway.app
VITE_WS_URL=ws://localhost:8000

# X-API-Key yang dipakai untuk autentikasi endpoint backend.
# Sama dengan API_KEYS di backend.
VITE_API_KEY=key1


# ─── Supabase (untuk Profil & Reset Password) ────────────────
# DIDIBUTUHKAN untuk fitur:
#   - Halaman Profil (upload avatar, edit nama, toggle notif)
#   - Reset Password Flow (kirim email + set password baru)
#
# Ambil dari: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Sentry Error Monitoring (Opsional untuk Dev) ────────────
# Kosongkan di dev → Sentry skip init (OK).
# WAJIB diisi untuk production deploy.
#
# Ambil dari: https://sentry.io → Settings → Projects → Client Keys (DSN)
VITE_SENTRY_DSN=
